# Local development. Start the database with: pnpm db:up
DATABASE_URL=postgres://bki:bki@127.0.0.1:5432/bki_academy
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=change-me

# Launch switches (L-01). Leave unset before launch: the site then asks search engines to stay away
# and every redirect is temporary.
# NEXT_PUBLIC_SITE_URL=https://your-launch-domain
# SITE_INDEXABLE=true
# REDIRECTS_PERMANENT=true
